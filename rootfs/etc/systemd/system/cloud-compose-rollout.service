[Unit]
Description=Cloud Compose Rollout API
After=network-online.target cloud-compose.service
Wants=network-online.target

[Service]
User=root
Group=root
EnvironmentFile=/home/cloud-compose/.env
WorkingDirectory=/mnt/disks/data
ExecStart=/usr/local/bin/cloud-compose-rollout
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
