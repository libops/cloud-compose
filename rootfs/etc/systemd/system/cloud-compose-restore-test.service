[Unit]
Description=Cloud Compose disposable disaster-recovery restore test
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/mnt/disks/data /mnt/disks/volumes

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/bash /usr/local/libexec/cloud-compose/run-root-program.sh restore-test.sh
TimeoutStartSec=24h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloud-compose-restore-test
