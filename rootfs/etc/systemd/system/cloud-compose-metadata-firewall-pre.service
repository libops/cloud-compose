[Unit]
Description=Install the pre-Docker GCP metadata guard
DefaultDependencies=no
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
ExecStart=/etc/cloud-compose/libexec/sitectl-host.sh metadata-firewall pre-docker
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
