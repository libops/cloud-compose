[Unit]
Description=Isolate GCP metadata from containers and unprivileged host processes
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/etc/cloud-compose/libexec/sitectl-host.sh metadata-firewall
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
