[Unit]
Description=Cloud Compose Internal Services (Ping, Metrics, Power Management)
BindsTo=docker.service
Requires=cloud-compose.service cloud-compose-metadata-firewall.service
RequiresMountsFor=/mnt/disks/data /mnt/disks/volumes /mnt/disks/data/docker/volumes
After=docker.service cloud-compose-metadata-firewall.service cloud-compose.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
User=cloud-compose
Group=cloud-compose
Environment="HOME=/home/cloud-compose"
WorkingDirectory=/mnt/disks/data/libops-internal
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=30s
TimeoutStopSec=10min

[Install]
WantedBy=multi-user.target
