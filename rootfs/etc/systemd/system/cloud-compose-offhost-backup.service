[Unit]
Description=Cloud Compose encrypted off-host disaster-recovery handoff
Requires=cloud-compose-mariadb-backup.service
After=cloud-compose-mariadb-backup.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/disks/data /mnt/disks/volumes

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/etc/cloud-compose/libexec/sitectl-host.sh backup offhost
TimeoutStartSec=24h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloud-compose-offhost-backup
