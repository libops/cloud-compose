#!/usr/bin/env bash

set -euo pipefail

umask 077
readonly bootstrap_sitectl=/run/cloud-compose-bootstrap-sitectl.sh
readonly sitectl=/etc/cloud-compose/bin/bootstrap-sitectl

printf '%s' '${BOOTSTRAP_SITECTL_B64}' | base64 -d | gzip -d >"$bootstrap_sitectl"
chmod 0700 "$bootstrap_sitectl"
bash "$bootstrap_sitectl" --version ${jsonencode(SITECTL_VERSION)}

"$sitectl" host filesystems \
    --data-device /dev/disk/by-id/google-data \
    --volumes-device /dev/disk/by-id/google-docker-volumes \
    --fresh-identity ${jsonencode(FRESH_FILESYSTEM_IDENTITY)} \
    --ready-marker /run/cloud-compose-filesystems-ready%{ if USE_OVERLAY } \
    --overlay-device /dev/disk/by-id/google-prod-volumes%{ endif }
