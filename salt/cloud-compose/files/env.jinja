{# cloud-compose-env-contract: Docker Compose double-quoted dotenv data; never source this file #}
{% for key, value in env | dictsort %}
{{ key }}="{{ value | string | replace("\\", "\\\\") | replace('"', '\\"') | replace("$", "$$") | replace("\n", "\\n") | replace("\r", "\\r") | replace("\t", "\\t") }}"
{% endfor %}
